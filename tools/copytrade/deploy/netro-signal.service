[Unit]
Description=Netro Signal Telegram bot
After=network-online.target
Wants=network-online.target
[Service]
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/netrovert-agents/tools/copytrade/tg_bot
EnvironmentFile=/home/YOUR_USER/.netro_signal.env.systemd
ExecStartPre=/bin/sh -c "date +%%s > /home/YOUR_USER/netrovert-agents/tools/copytrade/tg_bot/bot.heartbeat"
ExecStart=/home/YOUR_USER/venv/bin/python bot.py run
StandardOutput=append:/home/YOUR_USER/netrovert-agents/tools/copytrade/tg_bot/bot.log
StandardError=append:/home/YOUR_USER/netrovert-agents/tools/copytrade/tg_bot/bot.log
Restart=always
RestartSec=5
[Install]
WantedBy=multi-user.target
